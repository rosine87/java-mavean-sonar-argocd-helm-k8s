pipeline {
  agent none

  environment {
    DOCKER_IMAGE = "tsamodocker2020/ultimate-cicd-pipeline:${BUILD_NUMBER}"
    GIT_REPO_NAME = "java-mavean-sonar-argocd-helm-k8s"
    GIT_USER_NAME = "rosine87"
    MAVEN_OPTS = "-Dmaven.repo.local=${WORKSPACE}/.m2/repository"
    SONAR_USER_HOME = "${WORKSPACE}/.sonar"
    SONAR_HOST_URL = 'http://host.docker.internal:9000'
  }

  stages {

    stage('0. Checkout') {
      agent any
      steps {
        git branch: 'master', url: "https://github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git"
      }
    }

    stage('1. Build et Tests (Maven)') {
      agent {
        docker {
          image 'maven:3.9.6-eclipse-temurin-21'
        }
      }
      steps {
        dir('spring-boot-app') {
          sh 'mvn -B clean package'
        }
      }
    }

    stage('2. Analyse Statique SonarQube') {
      agent {
        docker {
          image 'maven:3.9.6-eclipse-temurin-21'
        }
      }
      steps {
        dir('spring-boot-app') {
          withCredentials([string(credentialsId: 'sonarqube', variable: 'SONAR_TOKEN')]) {
            sh '''
              mvn -B \
                -Dsonar.host.url=$SONAR_HOST_URL \
                -Dsonar.token=$SONAR_TOKEN \
                -Dsonar.userHome=$SONAR_USER_HOME \
                sonar:sonar
            '''
          }
        }
      }
    }

    stage('3. Build et Push Docker') {
      agent any
      steps {
        dir('spring-boot-app') {
          sh 'docker version'               // <-- test: doit marcher ici
          sh "docker build -t ${DOCKER_IMAGE} ."
        }

        script {
          docker.withRegistry('https://index.docker.io/v1/', 'docker-creds') {
            docker.image("${DOCKER_IMAGE}").push()
            docker.image("${DOCKER_IMAGE}").push('latest')
          }
        }
      }
    }

    stage('4. Mise à jour du manifeste Kubernetes') {
      agent none
      steps {
        withCredentials([string(credentialsId: 'github_secret', variable: 'GITHUB_TOKEN')]) {
          sh """
            set -e

            REPO_DIR="\$WORKSPACE/temp-gitops-repo"
            rm -rf "\$REPO_DIR"
            mkdir -p "\$REPO_DIR"

            echo "CLONE REPO..."
            git clone https://github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git "\$REPO_DIR"
            cd "\$REPO_DIR"

            echo "CONTENU DU REPO:"
            ls -R

            git config user.email "rosinetsamo15@gmail.com"
            git config user.name "rosine87"

            echo "UPDATE IMAGE VERSION DANS deployment.yaml"

            sed -i "s#image: .*#image: ${DOCKER_IMAGE}#g" charts/deployment.yaml

            git add charts/deployment.yaml

            if git diff --staged --quiet; then
              echo "Aucun changement → rien à pousser"
              exit 0
            fi

            git commit -m "Deploy v${BUILD_NUMBER}"
            git push https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git HEAD:master

            echo "Push réussi → ArgoCD va déployer 🚀"
          """
        }
      }
    }
  }
}